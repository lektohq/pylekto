#!/usr/bin/env bash
# Set up the repository: virtual environment, dependencies, Git hooks.

set -e

cd "$(dirname "$0")/.."

# Outside the devcontainer: a local .venv.
if [ -z "$VIRTUAL_ENV" ]; then
  if [ -x "$(command -v uv)" ]; then
    uv venv .venv
  else
    python3 -m venv .venv
  fi
  # shellcheck disable=SC1091
  source .venv/bin/activate
fi

if ! [ -x "$(command -v uv)" ]; then
  python3 -m pip install uv
fi

script/bootstrap

uv run prek install
